# Stellar Bounty Board - Environment Variables Template

# ===========================================
# Backend (Render)
# ===========================================

# Port (automatically set by Render)
# PORT=3001

# GitHub Webhook Secret (for validating webhook payloads)
# Get this from your GitHub App webhook settings
# GITHUB_WEBHOOK_SECRET=your_secret_here

# Optional: Database connection (if using a database instead of JSON file persistence)
# DATABASE_URL=postgresql://user:password@host:5432/bountyboard

# Optional: External API keys
# GITHUB_TOKEN=your_github_token_for_api_calls


# ===========================================
# Frontend (Vercel)
# ===========================================

# Backend API URL (required)
# Replace with your deployed backend URL
# VITE_API_BASE_URL=https://your-backend.onrender.com/api

# Alternative name (used in some configurations)
# VITE_API_URL=https://your-backend.onrender.com/api


# ===========================================
# Worker (Cron Jobs / Background Jobs)
# ===========================================

# Worker-specific environment variables
# WORKER_INTERVAL=60000
# WORKER_BATCH_SIZE=100


# ===========================================
# Notes
# ===========================================
#
# 1. Copy this file to .env and fill in the values
# 2. Never commit .env to version control
# 3. The backend works with JSON file persistence by default (no database required)
# 4. Frontend requires VITE_API_BASE_URL to be set for API calls to work
#